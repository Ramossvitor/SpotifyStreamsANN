{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.py", "timeout": 30 }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(*)"
    ]
  }
}
